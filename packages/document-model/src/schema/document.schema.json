{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-pdf2md.local/schema/document.schema.json",
  "title": "UnifiedPdf2MdDocument",
  "type": "object",
  "required": ["schemaVersion", "metadata", "pages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "metadata": {
      "type": "object",
      "required": ["source", "createdAt"],
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "enum": ["pdf", "markdown", "review-json", "unknown"] },
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "converter": { "type": "string" }
          }
        },
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "language": { "type": "string" },
        "targetLanguage": { "type": "string" }
      }
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "index", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "safeArea": { "$ref": "#/$defs/bbox" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "pageId", "order", "type", "text", "visible", "body", "safe"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "pageId": { "type": "string" },
        "order": { "type": "number" },
        "type": { "enum": ["text", "heading", "caption", "table", "image", "equation", "unknown"] },
        "text": { "type": "string" },
        "markdown": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "spans": { "type": "array", "items": { "$ref": "#/$defs/span" } },
        "visible": { "type": "boolean" },
        "body": { "type": "boolean" },
        "safe": { "type": "boolean" },
        "classification": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "method": { "enum": ["deterministic", "heuristic", "manual", "unknown"] },
            "reason": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "previousBlockId": { "type": "string" },
            "nextBlockId": { "type": "string" },
            "chainSeparator": { "enum": ["space", "newline"] }
          }
        },
        "translation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sourceLang": { "type": "string" },
            "targetLang": { "type": "string" },
            "text": { "type": "string" },
            "provider": { "type": "string" },
            "status": { "enum": ["pending", "translated", "failed", "skipped"] },
            "updatedAt": { "type": "string" },
            "error": { "type": "string" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "origin": { "enum": ["opengovsg", "eiaserinnys", "manual", "mock", "unknown"] },
            "originalIds": { "type": "array", "items": { "type": "string" } },
            "pageNumber": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "span": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": true,
      "properties": {
        "text": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "fontName": { "type": "string" },
        "fontSize": { "type": "number" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" }
      }
    }
  }
}
